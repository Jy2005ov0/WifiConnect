<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Campus login pages are often plain http:// and use self-signed hosts, so allow them. -->
	<!-- wificonnect://connect (widget) and wificonnect://setup (shared settings). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>WiFi Connect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wificonnect</string>
			</array>
		</dict>
	</array>
	<!-- Stay signed in: background checks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.wificonnect.keepalive</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
