          }
        }
      }
    },
    "Stay Signed In": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal Log Masuk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持登录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインを維持"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைந்தே இரு"
          }
        }
      }
    },
    "Stay Signed In checks in the background and signs you back in if the campus Wi-Fi logs you out. iOS decides exactly when it runs. Notifications appear when the app signs you in on its own.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekal Log Masuk menyemak di latar belakang dan melog masuk semula jika Wi-Fi kampus melog keluar anda. iOS menentukan bila ia dijalankan. Pemberitahuan dipaparkan apabila aplikasi melog masuk anda secara sendiri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“保持登录”会在后台检查，如果校园 Wi-Fi 让你退出登录，会自动重新登录。具体运行时间由 iOS 决定。应用自动为你登录时会显示通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「サインインを維持」はバックグラウンドで確認し、キャンパス Wi-Fi からログアウトされた場合は再度サインインします。実行のタイミングは iOS が決めます。アプリが自動でサインインすると通知が表示されます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“உள்நுழைந்தே இரு” பின்னணியில் சரிபார்த்து, வளாக Wi-Fi உங்களை வெளியேற்றினால் மீண்டும் உள்நுழைக்கும். அது எப்போது இயங்கும் என்பதை iOS தீர்மானிக்கும். செயலி தானாக உள்நுழைக்கும்போது அறிவிப்புகள் தோன்றும்."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Henti"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறுத்து"
          }
        }
      }
    },
    "Student ID": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "ID Pelajar"
