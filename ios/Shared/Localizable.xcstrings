        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在与学校的登录页面通信。"
          }
        }
      }
    },
    "Tap **Automation**, then tap **+** (or **New Automation**).": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik **Automasi**, kemudian ketik **+** (atau **Automasi Baharu**)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按**自动化**，然后点按**+**（或**新建自动化**）。"
          }
        }
      }
    },
    "Tap **Done**. That's it!": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik **Selesai**. Itu sahaja!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按**完成**。大功告成！"
          }
        }
      }
    },
    "Tap **New Blank Automation**, search for **WiFi Connect** and add **Log In to Campus Wi-Fi**.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik **Automasi Kosong Baharu**, cari **WiFi Connect** dan tambah **Log Masuk ke Wi-Fi Kampus**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按**新建空白自动化**，搜索 **WiFi Connect** 并添加**登录校园 Wi-Fi**。"
          }
        }
      }
    },
    "Tap to sign in to campus Wi-Fi.": {
      "localizations": {
        "ms": {
