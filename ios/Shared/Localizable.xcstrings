            "value": "சரி"
          }
        }
      }
    },
    "Only the Wi-Fi name and login page settings are shared. Never your student ID or password.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama Wi-Fi dan tetapan halaman log masuk dikongsi. Tidak sekali-kali ID pelajar atau kata laluan anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会分享 Wi-Fi 名称和登录页面设置，绝不会分享你的学号或密码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されるのは Wi-Fi 名とログインページの設定だけです。学籍番号やパスワードは共有されません。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi பெயரும் உள்நுழைவுப் பக்க அமைப்புகளும் மட்டுமே பகிரப்படும். உங்கள் மாணவர் எண்ணோ கடவுச்சொல்லோ ஒருபோதும் பகிரப்படாது."
          }
        }
      }
    },
