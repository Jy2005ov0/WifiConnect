          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க மேலே ஸ்வைப் செய்யவும்"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem"
          }
        },
        "zh-Hans": {
