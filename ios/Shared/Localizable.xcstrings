          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் முயலத் தட்டவும்"
          }
        }
      }
    },
    "Tap to sign in to campus Wi-Fi.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk log masuk ke Wi-Fi kampus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以登录校园 Wi-Fi。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてキャンパス Wi-Fi にサインイン。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வளாக Wi-Fi-இல் உள்நுழையத் தட்டவும்."
          }
        }
      }
    },
    "Test": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதி"
          }
        }
      }
    },
    "Test Again": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji Semula"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新测试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度測定"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் சோதி"
          }
        }
      }
    },
    "Tested over the Wi-Fi only, using Cloudflare's speed test servers. On fast Wi-Fi a test can use over 100 MB of data.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diuji melalui Wi-Fi sahaja, menggunakan pelayan ujian kelajuan Cloudflare. Pada Wi-Fi yang laju, satu ujian boleh menggunakan lebih 100 MB data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅通过 Wi-Fi 测试，使用 Cloudflare 的测速服务器。在高速 Wi-Fi 上，一次测试可能消耗超过 100 MB 流量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare の速度テストサーバーを使い、Wi-Fi のみで測定します。高速な Wi-Fi では 1 回で 100 MB 以上のデータを使うことがあります。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare வேகச் சோதனைச் சேவையகங்களைப் பயன்படுத்தி Wi-Fi-இல் மட்டுமே சோதிக்கப்படுகிறது. வேகமான Wi-Fi-இல் ஒரு சோதனை 100 MB-க்கு மேல் தரவைப் பயன்படுத்தலாம்."
          }
        }
      }
    },
    "The Wi-Fi name you join on campus. Used in the auto-connect guide.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama Wi-Fi yang anda sertai di kampus. Digunakan dalam panduan sambung automatik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在校园里连接的 Wi-Fi 名称，用于自动连接指南。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンパスで接続する Wi-Fi の名前です。自動接続ガイドで使われます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வளாகத்தில் நீங்கள் சேரும் Wi-Fi-இன் பெயர். தானியங்கு இணைப்பு வழிகாட்டியில் பயன்படுத்தப்படும்."
          }
        }
      }
    },
    "The custom login URL in Settings isn't valid.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "URL log masuk tersuai dalam Tetapan tidak sah."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”中的自定义登录网址无效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定のカスタムログイン URL が正しくありません。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் உள்ள தனிப்பயன் உள்நுழைவு URL சரியானதல்ல."
          }
        }
      }
    },
    "The login page didn't respond: %@": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk tidak memberi respons: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录页面没有响应：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインページが応答しませんでした: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைவுப் பக்கம் பதிலளிக்கவில்லை: %@"
          }
        }
      }
    },
    "The login page is found automatically, even when each building uses a different address. If that doesn't work, join the school Wi-Fi and tap Detect Login Page, or fill it in manually. Enter just the path, like /login, so it works in every building.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk ditemui secara automatik, walaupun setiap bangunan menggunakan alamat berbeza. Jika tidak berjaya, sertai Wi-Fi universiti dan ketik Kesan Halaman Log Masuk, atau isi secara manual. Masukkan laluan sahaja, seperti /login, supaya ia berfungsi di setiap bangunan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使每栋楼的地址不同，也会自动找到登录页面。如果无法找到，请连接学校 Wi-Fi 后点按“检测登录页面”，或手动填写。只需输入路径（例如 /login），这样在每栋楼都能使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "建物ごとにアドレスが違っても、ログインページは自動で見つかります。うまくいかない場合は、学校の Wi-Fi に接続して「ログインページを検出」をタップするか、手動で入力してください。どの建物でも使えるよう、/login のようにパスだけを入力します。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு கட்டடமும் வேறு முகவரியைப் பயன்படுத்தினாலும் உள்நுழைவுப் பக்கம் தானாகக் கண்டறியப்படும். அது வேலை செய்யவில்லை என்றால், பள்ளி Wi-Fi-இல் சேர்ந்து உள்நுழைவுப் பக்கத்தைக் கண்டறி என்பதைத் தட்டவும், அல்லது கைமுறையாக நிரப்பவும். எல்லாக் கட்டடங்களிலும் வேலை செய்ய /login போன்ற பாதையை மட்டும் உள்ளிடவும்."
          }
        }
      }
    },
    "The sign-out link didn't sign you out.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan log keluar tidak melog keluar anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出链接未能让你退出登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトのリンクでサインアウトできませんでした。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளியேறும் இணைப்பு உங்களை வெளியேற்றவில்லை."
          }
        }
      }
    },
    "Tip": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிப்பு"
          }
        }
      }
    },
    "To stop the login page from popping up, open **Settings › Wi-Fi**, tap **ⓘ** next to %@ and turn off **Auto-Login**.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menghentikan halaman log masuk daripada muncul, buka **Tetapan › Wi-Fi**, ketik **ⓘ** di sebelah %@ dan matikan **Log Masuk Auto**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要阻止登录页面弹出，请打开**设置 › 无线局域网**，点按 %@ 旁边的 **ⓘ**，然后关闭**自动登录**。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインページが表示されないようにするには、**設定 › Wi-Fi** を開き、%@ の横の **ⓘ** をタップして **自動ログイン** をオフにします。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைவுப் பக்கம் தோன்றுவதை நிறுத்த, **Settings › Wi-Fi** ஐத் திறந்து, %@ அருகிலுள்ள **ⓘ** ஐத் தட்டி **Auto-Login** ஐ முடக்கவும்."
          }
        }
      }
    },
    "URL or Path": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "URL atau Laluan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网址或路径"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL またはパス"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "URL அல்லது பாதை"
          }
        }
      }
    },
    "Unlock to see your student ID and password.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci untuk melihat ID pelajar dan kata laluan anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁以查看学号和密码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除して学籍番号とパスワードを表示します。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாணவர் எண்ணையும் கடவுச்சொல்லையும் பார்க்கத் திறக்கவும்."
          }
        }
      }
    },
    "Upload": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat Naik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவேற்றம்"
          }
        }
      }
    },
    "Use Setup": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna Tetapan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定を使う"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்பைப் பயன்படுத்து"
          }
        }
      }
    },
    "Use a classmate's setup?": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna tetapan rakan sekelas?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同学的设置？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラスメートの設定を使いますか？"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வகுப்புத் தோழரின் அமைப்பைப் பயன்படுத்தவா?"
          }
        }
      }
    },
    "Welcome": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat Datang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ようこそ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரவேற்கிறோம்"
          }
        }
      }
    },
    "When you opened the app": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semasa anda membuka aplikasi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いたとき"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் செயலியைத் திறந்தபோது"
          }
        }
      }
    },
    "Wi-Fi: %@. Login page: %@. Your own student ID and password stay the same.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: %@. Halaman log masuk: %@. ID pelajar dan kata laluan anda sendiri kekal sama."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi：%@。登录页面：%@。你自己的学号和密码保持不变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: %@。ログインページ: %@。あなたの学籍番号とパスワードは変わりません。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi: %@. உள்நுழைவுப் பக்கம்: %@. உங்கள் மாணவர் எண்ணும் கடவுச்சொல்லும் மாறாது."
          }
        }
      }
    },
    "Widget or Control Center": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget atau Pusat Kawalan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件或控制中心"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットまたはコントロールセンター"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விட்ஜெட் அல்லது கட்டுப்பாட்டு மையம்"
          }
        }
      }
    },
    "You're already online, so there's no login page to detect. Try again right after joining the school Wi-Fi.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah dalam talian, jadi tiada halaman log masuk untuk dikesan. Cuba lagi sebaik sahaja menyertai Wi-Fi universiti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经在线，所以没有可检测的登录页面。请在刚连接学校 Wi-Fi 后再试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにオンラインのため、検出するログインページがありません。学校の Wi-Fi に接続した直後にもう一度お試しください。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கனவே இணையத்தில் உள்ளதால் கண்டறிய உள்நுழைவுப் பக்கம் இல்லை. பள்ளி Wi-Fi-இல் சேர்ந்தவுடன் மீண்டும் முயலவும்."
          }
        }
      }
    },
    "You're already online.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah pun dalam talian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经在线。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにオンラインです。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கனவே இணையத்தில் உள்ளீர்கள்."
          }
        }
      }
    },
    "You're online.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dalam talian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已在线。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインです。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இணையத்தில் உள்ளீர்கள்."
          }
        }
      }
    },
    "You're signed in and online.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah log masuk dan dalam talian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已登录并在线。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしてオンラインです。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்நுழைந்து இணையத்தில் உள்ளீர்கள்."
          }
        }
      }
    },
    "You're signed in and ready to go.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah log masuk dan sedia untuk digunakan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已登录，可以上网了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしました。インターネットを使えます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்நுழைந்துவிட்டீர்கள், பயன்படுத்தத் தயார்."
          }
        }
      }
    },
    "You've signed out of the campus Wi-Fi.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah log keluar daripada Wi-Fi kampus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已退出校园 Wi-Fi。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンパス Wi-Fi からサインアウトしました。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வளாக Wi-Fi-இலிருந்து வெளியேறிவிட்டீர்கள்."
          }
        }
      }
    },
    "Your school's login page didn't show a sign-out link. You can add one in Settings › Login Page.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk universiti anda tidak menunjukkan pautan log keluar. Anda boleh menambahnya dalam Tetapan › Halaman Log Masuk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学校的登录页面没有提供退出链接。你可以在“设置 › 登录页面”中添加。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学校のログインページにサインアウトのリンクがありませんでした。設定 › ログインページで追加できます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பள்ளியின் உள்நுழைவுப் பக்கத்தில் வெளியேறும் இணைப்பு இல்லை. அமைப்புகள் › உள்நுழைவுப் பக்கம் என்பதில் சேர்க்கலாம்."
          }
        }
      }
    },
