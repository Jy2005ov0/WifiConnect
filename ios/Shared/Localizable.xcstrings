            "value": "வெளியேறிவிட்டீர்கள்"
          }
        }
      }
    },
    "Signed in, but there's still no internet. Check your student ID and password.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah log masuk, tetapi masih tiada internet. Semak ID pelajar dan kata laluan anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录，但仍无法上网。请检查你的学号和密码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしましたが、まだインターネットに接続できません。学籍番号とパスワードを確認してください。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைந்தது, ஆனால் இன்னும் இணையம் இல்லை. உங்கள் மாணவர் எண்ணையும் கடவுச்சொல்லையும் சரிபார்க்கவும்."
          }
        }
      }
    },
    "Signing In…": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang Log Masuk…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在登录…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைகிறது…"
          }
        }
      }
    },
    "Signs in to your school's Wi-Fi login page with your saved student ID and password.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk ke halaman log masuk Wi-Fi universiti anda dengan ID pelajar dan kata laluan yang disimpan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已保存的学号和密码登录学校的 Wi-Fi 登录页面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した学籍番号とパスワードで学校の Wi-Fi ログインページにサインインします。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்த மாணவர் எண் மற்றும் கடவுச்சொல்லுடன் பள்ளியின் Wi-Fi உள்நுழைவுப் பக்கத்தில் உள்நுழையும்."
          }
        }
      }
    },
    "Speed": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
