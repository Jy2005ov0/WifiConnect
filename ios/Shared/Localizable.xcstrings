    "Saved in your iPhone's Keychain and only sent to your school's login page.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan dalam Rantai Kunci iPhone anda dan hanya dihantar ke halaman log masuk universiti anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在 iPhone 的钥匙串中，只会发送到学校的登录页面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone のキーチェーンに保存され、学校のログインページにのみ送信されます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone Keychain-இல் சேமிக்கப்பட்டு, உங்கள் பள்ளியின் உள்நுழைவுப் பக்கத்துக்கு மட்டுமே அனுப்பப்படும்."
          }
        }
      }
    },
