    },
    "Found the login page at %@. Automatic sign-in works here and in other buildings, so there's nothing to set up.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk ditemui di %@. Log masuk automatik berfungsi di sini dan di bangunan lain, jadi tiada apa-apa untuk ditetapkan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 %@ 找到登录页面。自动登录在这里和其他楼都能使用，无需额外设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインページが %@ に見つかりました。ここでも他の建物でも自動サインインが使えるので、設定は不要です。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைவுப் பக்கம் %@ இல் கண்டறியப்பட்டது. இங்கும் பிற கட்டடங்களிலும் தானியங்கு உள்நுழைவு வேலை செய்யும், அமைக்க எதுவும் இல்லை."
          }
        }
      }
    },
    "Found the login page at %@. The details above have been updated.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk ditemui di %@. Butiran di atas telah dikemas kini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 %@ 找到登录页面。上面的信息已更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインページが %@ に見つかりました。上の詳細を更新しました。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைவுப் பக்கம் %@ இல் கண்டறியப்பட்டது. மேலே உள்ள விவரங்கள் புதுப்பிக்கப்பட்டன."
          }
