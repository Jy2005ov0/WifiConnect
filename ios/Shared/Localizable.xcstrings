{
  "sourceLanguage": "en",
  "strings": {
    "%lld ms · %@ Mbps": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ms · %@ Mbps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 毫秒 · %@ Mbps"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Add Student ID": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ID Pelajar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加学号"
          }
        }
      }
    },
    "Add your student ID and password in Settings first.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ID pelajar dan kata laluan anda dalam Tetapan dahulu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”中添加学号和密码。"
          }
        }
      }
    },
    "Add your student ID and password to get started.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ID pelajar dan kata laluan anda untuk bermula."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你的学号和密码即可开始使用。"
          }
        }
      }
    },
    "Already Online": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah Dalam Talian"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在线"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penampilan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Ask a classmate to scan this with their phone's camera. WiFi Connect opens with your Wi-Fi and login page settings filled in.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta rakan sekelas mengimbas kod ini dengan kamera telefon mereka. WiFi Connect akan dibuka dengan tetapan Wi-Fi dan halaman log masuk anda telah diisi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同学用手机相机扫描此二维码。WiFi Connect 会打开并自动填好你的 Wi-Fi 和登录页面设置。"
          }
        }
      }
    },
    "Asks for %@ before showing Settings, where your password is saved.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta %@ sebelum menunjukkan Tetapan, tempat kata laluan anda disimpan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在显示保存密码的“设置”之前要求验证%@。"
          }
        }
      }
    },
    "Auto Sign-In": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log Masuk Automatik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动登录"
          }
        }
      }
    },
    "Automatic Sign-In": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log Masuk Automatik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动登录"
          }
        }
      }
    },
    "Campus Wi-Fi": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi Kampus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校园 Wi-Fi"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Choose **Wi-Fi**, tap **Network** and pick %@.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih **Wi-Fi**, ketik **Rangkaian** dan pilih %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择**无线局域网**，点按**网络**，然后选取 %@。"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Clear History": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan Sejarah"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除记录"
          }
        }
      }
    },
    "Clear sign-in history?": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan sejarah log masuk?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除登录记录？"
          }
        }
      }
    },
    "Confirm it's you to change the app lock.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan ini anda untuk menukar kunci aplikasi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认是你本人以更改应用锁。"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambung"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersambung"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "Connected to %@": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersambung ke %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接到 %@"
          }
        }
      }
    },
    "Couldn't Sign In": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak Dapat Log Masuk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法登录"
          }
        }
      }
    },
    "Couldn't find a login form on your school's page. Set the login page manually in Settings.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menemui borang log masuk pada halaman universiti anda. Tetapkan halaman log masuk secara manual dalam Tetapan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在学校的页面上找不到登录表单。请在“设置”中手动设置登录页面。"
          }
        }
      }
    },
    "Couldn't reach the Wi-Fi. Make sure you're connected to your school's network.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mencapai Wi-Fi. Pastikan anda bersambung ke rangkaian universiti anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Wi-Fi。请确认你已连接到学校的网络。"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelap"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色"
          }
        }
      }
    },
    "Detect Login Page": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan Halaman Log Masuk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测登录页面"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Extra fields, one name=value per line": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Medan tambahan, satu nama=nilai setiap baris"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额外字段，每行一个“名称=值”"
          }
        }
      }
    },
    "Found the login page at %@. Automatic sign-in works here and in other buildings, so there's nothing to set up.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk ditemui di %@. Log masuk automatik berfungsi di sini dan di bangunan lain, jadi tiada apa-apa untuk ditetapkan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 %@ 找到登录页面。自动登录在这里和其他楼都能使用，无需额外设置。"
          }
        }
      }
    },
    "Found the login page at %@. The details above have been updated.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman log masuk ditemui di %@. Butiran di atas telah dikemas kini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 %@ 找到登录页面。上面的信息已更新。"
          }
        }
      }
    },
    "From the app": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daripada aplikasi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用中"
          }
        }
      }
    },
