{
  "sourceLanguage": "en",
  "strings": {
    "Account": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்கு"
          }
        }
      }
    },
    "Add Student ID": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ID Pelajar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加学号"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学籍番号を追加"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாணவர் எண்ணைச் சேர்"
          }
        }
      }
    },
    "Add your student ID and password in Settings first.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ID pelajar dan kata laluan anda dalam Tetapan dahulu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”中添加学号和密码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に設定で学籍番号とパスワードを追加してください。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் அமைப்புகளில் உங்கள் மாணவர் எண்ணையும் கடவுச்சொல்லையும் சேர்க்கவும்."
          }
        }
      }
    },
    "Add your student ID and password to get started.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah ID pelajar dan kata laluan anda untuk bermula."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你的学号和密码即可开始使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学籍番号とパスワードを追加して始めましょう。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க உங்கள் மாணவர் எண்ணையும் கடவுச்சொல்லையும் சேர்க்கவும்."
          }
        }
      }
    },
    "Already Online": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah Dalam Talian"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在线"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにオンライン"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கனவே இணையத்தில்"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penampilan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோற்றம்"
          }
        }
      }
    },
    "Ask a classmate to scan this with their phone's camera. WiFi Connect opens with your Wi-Fi and login page settings filled in.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta rakan sekelas mengimbas kod ini dengan kamera telefon mereka. WiFi Connect akan dibuka dengan tetapan Wi-Fi dan halaman log masuk anda telah diisi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同学用手机相机扫描此二维码。WiFi Connect 会打开并自动填好你的 Wi-Fi 和登录页面设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラスメートにスマートフォンのカメラでこれをスキャンしてもらいましょう。WiFi Connect が開き、Wi-Fi とログインページの設定が入力されます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வகுப்புத் தோழரைத் தொலைபேசி கேமராவால் இதை ஸ்கேன் செய்யச் சொல்லுங்கள். உங்கள் Wi-Fi மற்றும் உள்நுழைவுப் பக்க அமைப்புகளுடன் WiFi Connect திறக்கும்."
          }
        }
      }
    },
    "Asks for %@ before showing Settings, where your password is saved.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meminta %@ sebelum menunjukkan Tetapan, tempat kata laluan anda disimpan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在显示保存密码的“设置”之前要求验证%@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが保存されている設定を表示する前に %@ を求めます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுச்சொல் சேமிக்கப்பட்டுள்ள அமைப்புகளைக் காட்டும் முன் %@ கேட்கும்."
          }
        }
      }
    },
    "Auto Sign-In": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log Masuk Automatik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动登录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動サインイン"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கு உள்நுழைவு"
          }
        }
      }
    },
    "Automatic Sign-In": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log Masuk Automatik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动登录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動サインイン"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கு உள்நுழைவு"
          }
        }
      }
    },
    "Campus Wi-Fi": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi Kampus"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校园 Wi-Fi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンパス Wi-Fi"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வளாக Wi-Fi"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Batal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ரத்துசெய்"
          }
        }
      }
    },
    "Choose **Wi-Fi**, tap **Network** and pick %@.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih **Wi-Fi**, ketik **Rangkaian** dan pilih %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择**无线局域网**，点按**网络**，然后选取 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Wi-Fi** を選び、**ネットワーク** をタップして %@ を選択します。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "**Wi-Fi** என்பதைத் தேர்ந்து, **நெட்வொர்க்** என்பதைத் தட்டி %@ ஐத் தேர்ந்தெடுக்கவும்."
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அழி"
          }
        }
      }
    },
    "Clear History": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan Sejarah"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除记录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を消去"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரலாற்றை அழி"
          }
        }
      }
    },
    "Clear sign-in history?": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan sejarah log masuk?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除登录记录？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン履歴を消去しますか？"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைவு வரலாற்றை அழிக்கவா?"
          }
        }
      }
    },
    "Close and reopen WiFi Connect to use the new language.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup dan buka semula WiFi Connect untuk menggunakan bahasa baharu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭并重新打开 WiFi Connect 即可使用新语言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語を使うには WiFi Connect を閉じて開き直してください。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய மொழியைப் பயன்படுத்த WiFi Connect-ஐ மூடி மீண்டும் திறக்கவும்."
          }
        }
      }
    },
    "Confirm it's you to change the app lock.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan ini anda untuk menukar kunci aplikasi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认是你本人以更改应用锁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリロックを変更するには本人確認が必要です。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலிப் பூட்டை மாற்ற இது நீங்கள்தான் என உறுதிசெய்யவும்."
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersambung"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済み"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைக்கப்பட்டது"
          }
        }
      }
    },
    "Connected to %@": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersambung ke %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接到 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続しました"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ உடன் இணைந்தது"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disalin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நகலெடுக்கப்பட்டது"
          }
        }
      }
    },
    "Copy Diagnostics": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin Diagnostik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制诊断信息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報をコピー"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்டறிதல் தகவலை நகலெடு"
          }
        }
      }
    },
    "Couldn't Sign In": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak Dapat Log Masuk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法登录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインできませんでした"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைய முடியவில்லை"
          }
        }
      }
    },
    "Couldn't Test": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak Dapat Menguji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法测试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定できませんでした"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதிக்க முடியவில்லை"
          }
        }
      }
    },
    "Couldn't find a login form on your school's page. Set the login page manually in Settings.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menemui borang log masuk pada halaman universiti anda. Tetapkan halaman log masuk secara manual dalam Tetapan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在学校的页面上找不到登录表单。请在“设置”中手动设置登录页面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学校のページにログインフォームが見つかりませんでした。設定でログインページを手動で設定してください。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பள்ளிப் பக்கத்தில் உள்நுழைவுப் படிவம் கிடைக்கவில்லை. அமைப்புகளில் உள்நுழைவுப் பக்கத்தைக் கைமுறையாக அமைக்கவும்."
          }
        }
      }
    },
    "Couldn't reach the Wi-Fi. Make sure you're connected to your school's network.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mencapai Wi-Fi. Pastikan anda bersambung ke rangkaian universiti anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Wi-Fi。请确认你已连接到学校的网络。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi に接続できませんでした。学校のネットワークに接続しているか確認してください。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi-ஐ அடைய முடியவில்லை. உங்கள் பள்ளி நெட்வொர்க்குடன் இணைந்துள்ளீர்களா எனச் சரிபார்க்கவும்."
          }
        }
      }
    },
    "Couldn't reach the test server. Make sure you're connected to the Wi-Fi and online.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mencapai pelayan ujian. Pastikan anda bersambung ke Wi-Fi dan dalam talian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接测试服务器。请确认你已连接 Wi-Fi 并且可以上网。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストサーバーに接続できませんでした。Wi-Fi に接続してオンラインになっているか確認してください。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதனைச் சேவையகத்தை அடைய முடியவில்லை. Wi-Fi-உடன் இணைந்து இணையத்தில் உள்ளீர்களா எனச் சரிபார்க்கவும்."
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelap"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーク"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருள்"
          }
        }
      }
