    "See if you're signed in, and sign in with one tap.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat sama ada anda telah log masuk, dan log masuk dengan satu ketikan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看是否已登录，一键登录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン状態を確認し、ワンタップでサインインできます。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்நுழைந்துள்ளீர்களா எனப் பார்த்து, ஒரே தட்டலில் உள்நுழையலாம்."
          }
        }
      }
    },
    "Select **Run Immediately**, then tap **Next**.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih **Jalankan Serta-merta**, kemudian ketik **Seterusnya**."
