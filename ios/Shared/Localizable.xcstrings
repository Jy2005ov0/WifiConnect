        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择**立即运行**，然后点按**下一步**。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**すぐに実行** を選んで **次へ** をタップします。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "**உடனடியாக இயக்கு** என்பதைத் தேர்ந்து, **அடுத்து** என்பதைத் தட்டவும்."
