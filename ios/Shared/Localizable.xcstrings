    "Only the Wi-Fi name and login page settings are shared. Never your student ID or password.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya nama Wi-Fi dan tetapan halaman log masuk dikongsi. Tidak sekali-kali ID pelajar atau kata laluan anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会分享 Wi-Fi 名称和登录页面设置，绝不会分享你的学号或密码。"
          }
        }
      }
    },
