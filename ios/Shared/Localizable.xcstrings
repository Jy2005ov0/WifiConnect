            "state": "translated",
            "value": "GET"
          }
        }
      }
    },
    "Help": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantuan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助"
          }
        }
      }
    },
    "ID Field": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Medan ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学号字段"
          }
        }
      }
    },
    "If signing in doesn't work, copy this report and send it to whoever helps you with the app. It includes the login page details but never your password.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika log masuk tidak berjaya, salin laporan ini dan hantar kepada sesiapa yang membantu anda dengan aplikasi ini. Ia mengandungi butiran halaman log masuk tetapi tidak sekali-kali kata laluan anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果无法登录，请复制这份报告并发送给帮助你使用此应用的人。报告包含登录页面信息，但绝不包含你的密码。"
          }
        }
      }
    },
    "In the Shortcuts app": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam aplikasi Pintasan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“快捷指令”App 中"
          }
        }
      }
    },
    "Join campus Wi-Fi first.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertai Wi-Fi kampus dahulu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先连接校园 Wi-Fi。"
          }
        }
      }
    },
    "Join your school's Wi-Fi, then tap Connect.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertai Wi-Fi universiti anda, kemudian ketik Sambung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接学校的 Wi-Fi，然后点按“连接”。"
          }
        }
      }
    },
    "Let your iPhone sign in for you every time you arrive on campus.": {
      "localizations": {
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan iPhone anda log masuk untuk anda setiap kali anda tiba di kampus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次到达校园时，让 iPhone 自动为你登录。"
          }
        }
      }
    },
